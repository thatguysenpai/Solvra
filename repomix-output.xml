<file path="app/api/chat/route.ts">
import { NextResponse } from 'next/server';
import { retrieveRelevantChunks } from '@/lib/knowledgeBase';

const GROQ_API_KEY = process.env.GROQ_API_KEY;
const GROQ_MODEL = process.env.GROQ_MODEL || 'llama-3.3-70b-versatile';
const GROQ_URL = 'https://api.groq.com/openai/v1/chat/completions';

const CRISIS_KEYWORDS = [
  'suicide', 'kill myself', 'end my life', 'self harm', 'self-harm',
  'hurt myself', 'want to die', "don't want to live",
];

function containsCrisisLanguage(text: string): boolean {
  const lower = text.toLowerCase();
  return CRISIS_KEYWORDS.some((kw) => lower.includes(kw));
}

const CRISIS_RESPONSE = `I hear that you're going through something really painful right now, and I want you to be safe. I'm not able to provide crisis support myself, but please reach out to people who can help right away:

- If you're in immediate danger, contact your local emergency services.
- In the US: call or text 988 (Suicide and Crisis Lifeline).
- In Nigeria: the Mentally Aware Nigeria Initiative (MANI) helpline can help.

Please also consider reaching out to someone you trust right now. You don't have to go through this alone.`;

function buildSystemPrompt(context: { topic: string; text: string }[]): string {
  const contextBlock = context.length
    ? context.map((c, i) => `[${i + 1}] (${c.topic}) ${c.text}`).join('\n\n')
    : 'No specific reference material matched this message.';

  return `You are a warm, supportive mental health companion chatbot called SafeSpace. You are not a therapist and you never diagnose. You listen, validate feelings, and gently offer relevant, practical coping suggestions grounded ONLY in the reference material below when it is relevant. If the reference material doesn't clearly apply, just respond supportively without forcing it in. Keep responses concise (3-6 sentences), warm, and conversational â€” not clinical or listy unless the user asks for steps.

Reference material:
${contextBlock}`;
}

async function callGroq(userMessage: string, systemPrompt: string): Promise<string | null> {
  if (!GROQ_API_KEY) return null;

  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 20000);

    const res = await fetch(GROQ_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${GROQ_API_KEY}`,
      },
      body: JSON.stringify({
        model: GROQ_MODEL,
        messages: [
          { role: 'system', content: systemPrompt },
          { role: 'user', content: userMessage },
        ],
        temperature: 0.7,
        max_tokens: 400,
      }),
      signal: controller.signal,
    });

    clearTimeout(timeout);

    if (!res.ok) {
      console.error('Groq API error:', res.status, await res.text());
      return null;
    }

    const data = await res.json();
    return data?.choices?.[0]?.message?.content?.trim() || null;
  } catch (err) {
    console.error('Groq call failed:', err);
    return null;
  }
}

/** Fallback used when Groq is unreachable or no API key is set: still grounded in retrieval, just templated. */
function buildFallbackResponse(userMessage: string, context: { topic: string; text: string }[]): string {
  if (context.length === 0) {
    return "I hear you. Thank you for sharing that with me â€” I'm here to listen. Could you tell me a bit more about what's on your mind?";
  }
  const top = context[0];
  return `I hear you. That sounds like it relates to ${top.topic}. One thing that can help: ${top.text} Would you like to talk more about what's been going on?`;
}

export async function POST(request: Request) {
  try {
    const { message } = await request.json();

    if (!message || typeof message !== 'string' || !message.trim()) {
      return NextResponse.json({ error: 'Message is required' }, { status: 400 });
    }

    if (containsCrisisLanguage(message)) {
      return NextResponse.json({ response: CRISIS_RESPONSE, usedLLM: false, sources: [] });
    }

    const relevantChunks = retrieveRelevantChunks(message, 3);
    const systemPrompt = buildSystemPrompt(relevantChunks);

    const llmResponse = await callGroq(message, systemPrompt);
    const response = llmResponse || buildFallbackResponse(message, relevantChunks);

    return NextResponse.json({
      response,
      usedLLM: llmResponse !== null,
      sources: relevantChunks.map((c) => c.topic),
    });
  } catch (error) {
    console.error('Chat API error:', error);
    return NextResponse.json(
      { error: 'Something went wrong processing your message.' },
      { status: 500 }
    );
  }
}
