// Small local knowledge base for the RAG chatbot.
// Each entry is a short, self-contained chunk so retrieval stays precise.
// This is general supportive/psychoeducational content, not medical advice.

export interface KBChunk {
  id: string;
  topic: string;
  text: string;
}

export const knowledgeBase: KBChunk[] = [
  {
    id: 'anxiety-grounding',
    topic: 'anxiety, panic, overwhelm',
    text: 'When anxiety feels overwhelming, grounding techniques can help bring attention back to the present moment. One common method is the 5-4-3-2-1 technique: name 5 things you can see, 4 things you can touch, 3 things you can hear, 2 things you can smell, and 1 thing you can taste. Slow, deep breathing (inhale for 4 counts, hold for 4, exhale for 6) can also calm the nervous system.',
  },
  {
    id: 'stress-breathing',
    topic: 'stress, tension, racing thoughts',
    text: 'Box breathing is a simple technique for reducing stress: breathe in for 4 seconds, hold for 4 seconds, breathe out for 4 seconds, hold for 4 seconds, and repeat. Regular short breaks, stepping away from a stressful task for even five minutes, and stretching can also lower physical tension.',
  },
  {
    id: 'sleep-hygiene',
    topic: 'sleep, insomnia, tiredness',
    text: 'Good sleep habits include keeping a consistent sleep and wake time, avoiding screens for 30-60 minutes before bed, keeping the room cool and dark, and avoiding caffeine in the afternoon and evening. If racing thoughts keep you up, writing them down in a notebook before bed can help offload them.',
  },
  {
    id: 'low-mood-behavioral-activation',
    topic: 'low mood, sadness, depression, lack of motivation',
    text: 'When mood is low, motivation often follows action rather than preceding it. Behavioral activation means choosing one small, achievable activity, even something as simple as a short walk, tidying one corner of a room, or messaging a friend, rather than waiting to feel motivated first. Small consistent steps tend to help more than big ambitious plans.',
  },
  {
    id: 'journaling-benefits',
    topic: 'journaling, reflection, processing emotions',
    text: 'Writing about thoughts and feelings, even briefly, can help process difficult emotions and identify patterns over time. It can help to note not just what happened, but what you felt and what you needed in that moment. There is no right way to journal; short, honest entries are often more useful than long, polished ones.',
  },
  {
    id: 'negative-thought-patterns',
    topic: 'negative thoughts, self-criticism, cognitive distortions',
    text: 'Common unhelpful thinking patterns include catastrophizing (assuming the worst outcome), all-or-nothing thinking (seeing things as entirely good or bad), and mind reading (assuming you know what others think of you). Noticing when a thought fits one of these patterns, and asking "what evidence do I actually have for this?", can create some distance from it.',
  },
  {
    id: 'social-connection',
    topic: 'loneliness, isolation, relationships',
    text: 'Loneliness can worsen low mood and anxiety, and reaching out, even a short message to one person, can help break the cycle. It is common to feel like a burden when considering reaching out; most people are more receptive to being contacted than we predict they will be.',
  },
  {
    id: 'crisis-resources',
    topic: 'crisis, suicidal thoughts, self-harm, emergency',
    text: 'If someone is in crisis or having thoughts of suicide or self-harm, this is urgent and professional or emergency support should be sought immediately rather than relying on self-help techniques. In the US, the 988 Suicide and Crisis Lifeline can be reached by calling or texting 988. In Nigeria, resources include the Mentally Aware Nigeria Initiative (MANI) helpline. If there is immediate danger, local emergency services should be contacted.',
  },
  {
    id: 'academic-stress',
    topic: 'academic pressure, exams, deadlines, school stress',
    text: 'Academic stress often builds when tasks feel large and undefined. Breaking work into small, specific, time-boxed chunks (e.g. "outline section 1 for 25 minutes") rather than vague goals ("study for exam") reduces the sense of overwhelm and makes starting easier. Regular short breaks (e.g. the Pomodoro technique) also help sustain focus over long study sessions.',
  },
  {
    id: 'self-compassion',
    topic: 'self-criticism, guilt, shame, self-compassion',
    text: 'Self-compassion involves treating yourself with the same kindness you would offer a friend in the same situation, rather than harsh self-criticism. Research suggests self-compassion is associated with greater resilience and motivation than self-criticism, despite the common belief that being hard on oneself is necessary to improve.',
  },
  {
    id: 'anger-management',
    topic: 'anger, frustration, irritability',
    text: 'When anger rises, it often helps to create space before reacting: stepping away from the situation for a few minutes, slowing the breath, and naming the emotion internally ("I am feeling angry right now") can reduce the intensity of the reaction. Physical activity, like a brisk walk, can also help discharge the physiological arousal that comes with anger.',
  },
  {
    id: 'burnout',
    topic: 'burnout, exhaustion, overwork',
    text: 'Burnout typically develops from prolonged stress without adequate recovery, and shows up as emotional exhaustion, cynicism, and reduced sense of accomplishment. Recovery usually requires actually reducing load where possible, protecting rest and sleep, and reconnecting with activities that feel meaningful rather than just obligatory.',
  },
];

/** Very small tokenizer: lowercase, strip punctuation, split on whitespace. */
function tokenize(text: string): string[] {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9\s]/g, ' ')
    .split(/\s+/)
    .filter((w) => w.length > 2);
}

const STOPWORDS = new Set([
  'the', 'and', 'for', 'are', 'but', 'not', 'you', 'your', 'with', 'this',
  'that', 'have', 'has', 'was', 'were', 'can', 'could', 'should', 'would',
  'about', 'from', 'into', 'over', 'when', 'what', 'how', 'why', 'feel',
  'feeling', 'like', 'just', 'really', 'been', 'being', 'they', 'them',
]);

interface ScoredChunk extends KBChunk {
  score: number;
}

/**
 * Extremely simple retrieval: TF overlap between the query and each chunk
 * (topic + text), weighted slightly toward topic matches. No embeddings,
 * no vector DB â€” good enough for a small fixed corpus like this one.
 */
export function retrieveRelevantChunks(query: string, topK = 3): ScoredChunk[] {
  const queryTokens = tokenize(query).filter((t) => !STOPWORDS.has(t));
  if (queryTokens.length === 0) return [];

  const scored: ScoredChunk[] = knowledgeBase.map((chunk) => {
    const topicTokens = tokenize(chunk.topic);
    const textTokens = tokenize(chunk.text);

    let score = 0;
    for (const qt of queryTokens) {
      if (topicTokens.includes(qt)) score += 2;
      if (textTokens.includes(qt)) score += 1;
    }

    return { ...chunk, score };
  });

  return scored
    .filter((c) => c.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, topK);
}
