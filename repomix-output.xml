@import "tailwindcss";

/* ── Solvra design tokens (warm paper / terracotta) ─────────────────────── */
@theme {
  --color-paper: #faf9f5;
  --color-sidebar: #f5f3ed;
  --color-card: #ffffff;
  --color-line: #eae7e1;
  --color-line-strong: #ddd9d0;
  --color-hover: #efece5;
  --color-hover-strong: #ece8e0;
  --color-ink: #262420;
  --color-ink-soft: #6b665e;
  --color-ink-muted: #9e998e;
  --color-accent: #cc6343;
  --color-accent-hover: #ba5637;
  --color-accent-tint: #fbf0ec;
  --color-brand: #205493;
  --color-code: #211e1c;

  --font-sans: "Inter Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-serif: "Newsreader Variable", Georgia, serif;
  --font-display: "Instrument Serif", Georgia, serif;
  --font-mono: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, monospace;

  --animate-dot: dot 1.2s ease-in-out infinite;
  @keyframes dot {
    0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-2px); }
  }
}

:root { color-scheme: light; }

html, body { height: 100%; }

body {
  background: var(--color-paper);
  color: var(--color-ink);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}

::selection { background: #f3e3db; color: #5b291a; }

/* Quiet scrollbars */
* { scrollbar-width: thin; scrollbar-color: #ddd8ce transparent; }
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #ddd8ce; border-radius: 9999px; }
::-webkit-scrollbar-thumb:hover { background: #c4beb2; }

/* ── Assistant markdown ─────────────────────────────────────────────────── */
.md { font-size: 15px; line-height: 1.7; color: var(--color-ink); overflow-wrap: anywhere; }
.md > * + * { margin-top: 0.9em; }
.md h1, .md h2 { font-family: var(--font-display); font-weight: 400; line-height: 1.2; color: #1a1917; }
.md h1 { font-size: 1.75rem; margin-top: 1.4em; }
.md h2 { font-size: 1.4rem; margin-top: 1.3em; }
.md h3 { font-size: 0.95rem; font-weight: 600; margin-top: 1.2em; }
.md h4, .md h5, .md h6 { font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-ink-soft); font-weight: 600; margin-top: 1.2em; }
.md ul, .md ol { padding-left: 1.4rem; }
.md ul { list-style: disc; }
.md ol { list-style: decimal; }
.md li + li { margin-top: 0.3em; }
.md li::marker { color: var(--color-ink-muted); }
.md a { color: var(--color-accent-hover); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #e6bcae; }
.md a:hover { text-decoration-color: currentColor; }
.md strong { font-weight: 600; }
.md hr { border: 0; border-top: 1px solid var(--color-line); margin: 1.5em 0; }
.md blockquote { border-left: 2px solid var(--color-accent); padding: 0.1rem 0 0.1rem 1rem; font-family: var(--font-serif); font-style: italic; font-size: 1.05rem; color: #423e37; }
.md :not(pre) > code { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-hover); border: 1px solid var(--color-line); border-radius: 6px; padding: 0.1em 0.35em; }
.md table { width: 100%; border-collapse: collapse; font-size: 13px; }
.md th { text-align: left; font-weight: 500; color: #7c766c; background: var(--color-paper); }
.md th, .md td { padding: 0.5rem 0.85rem; border-bottom: 1px solid var(--color-line); vertical-align: top; }
.md tr:last-child td { border-bottom: 0; }
</file>

