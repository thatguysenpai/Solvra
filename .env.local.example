# 1. Overwrite the example file with a safe placeholder
@'
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional - any Groq chat model works with this code unchanged.
GROQ_MODEL=openai/gpt-oss-120b
'@ | Set-Content .env.local.example -Encoding ascii

# 2. Stop tracking repomix-output.xml (a packed dump of the old code, it doesn't belong in the repo)
git rm --cached repomix-output.xml
Remove-Item repomix-output.xml
Add-Content .gitignore "`nrepomix-output.xml"

# 3. Rewrite the last commit so the key is gone from it
git add .
git commit --amend --no-edit

# 4. Confirm no key remains anywhere in the tracked history
git log -p --all -S"gsk_" --oneline